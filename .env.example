# Company / product
COMPANY_NAME=Acme Corp
COMPANY_TIMEZONE=Asia/Yerevan
APP_DOMAIN=attendance.local
PRODUCT_VERSION=1.0.0

# Database (informational data — never wipe volume on update)
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ISSUER=DitakWorkTime
JWT_AUDIENCE=DitakWorkTimeWeb
JWT_EXPIRES_MINUTES=480

# Seed admin (first install only)
SEED_ADMIN_EMAIL=admin@company.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=System Admin

# Public URLs
API_PUBLIC_URL=http://localhost/api
WEB_PUBLIC_URL=http://localhost/
ADMIN_PUBLIC_URL=http://localhost/admin

# CORS
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Laravel
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=false
API_BASE_URL=http://api:8080
